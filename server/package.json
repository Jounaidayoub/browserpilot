{
  "name": "@ayoubj/browserpilot",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "browserpilot": "./dist/cli.js"
  },
  "repository": {
    "url": "https://github.com/Jounaidayoub/browserpilot"
  },
  "homepage": "https://github.com/Jounaidayoub/browserpilot#readme",
  "files": [
    "dist"
  ],
  "scripts": {
    "gen:tools": "node ./scripts/copy-tool-definitions.mjs",
    "dev": "pnpm run gen:tools && tsx watch src/index.ts",
    "dev:cli": "pnpm run gen:tools && tsx src/cli.ts",
    "build": "pnpm run gen:tools && vite build",
    "start": "node ./dist/index.js",
    "setup": "node ./dist/cli.js setup",
    "config:list": "node ./dist/cli.js config list"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/devtools": "^0.0.15",
    "@ai-sdk/google": "^3.0.58",
    "@ai-sdk/mcp": "^1.0.32",
    "@ai-sdk/openai": "3.0.50",
    "@ai-sdk/openai-compatible": "^2.0.38",
    "@hono/node-server": "^1.19.5",
    "ai": "6.0.146",
    "commander": "^14.0.1",
    "hono": "^4.9.10",
    "inquirer": "^12.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "rollup-plugin-node-externals": "^8.1.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.5"
  }
}
